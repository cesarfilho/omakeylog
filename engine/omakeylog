# ---------------------------------------------------------------------------
# storage helpers
# ---------------------------------------------------------------------------
# Counts are private: only the owner may read them, whatever the umask.
def _ensure_dir(path=None):
    path = path or DATA_DIR
    os.makedirs(path, mode=0o700, exist_ok=True)
    os.chmod(path, 0o700)


def _write_private(path, text):
    _ensure_dir(os.path.dirname(path))
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.replace(tmp, path)


def _write_json(path, obj):
    _write_private(path, json.dumps(obj, separators=(",", ":")))


def secure_existing():
    """Tighten files written by 1.0, which followed the umask (often 0644)."""
    for d in (DATA_DIR, CONFIG_DIR):
        if not os.path.isdir(d):
            continue
        os.chmod(d, 0o700)
        for name in os.listdir(d):
            path = os.path.join(d, name)
            if os.path.isfile(path) and not os.path.islink(path):
                os.chmod(path, 0o600)


def _read_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def pid_alive(pid):
    """True only if pid is a running omakeylog - a bare os.kill(pid, 0) would
    also accept an unrelated process that reused the number after a reboot."""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return False  # not ours, so not our recorder
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            return b"omakeylog" in fh.read()
    except OSError:
        return False


def read_pid():
    try:
        with open(PIDFILE) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return 0


def _set_wanted(wanted):
    _write_json(STATE, {"wanted": bool(wanted)})


def _wanted():
    return _read_json(STATE, {}).get("wanted") is True


# ---------------------------------------------------------------------------
# counting - pure, so it can be tested without a keyboard
# ---------------------------------------------------------------------------
def _bucket(ms):
    return str(min(BUCKET_CAP_MS, int(round(ms)) // BUCKET_MS * BUCKET_MS))


def _inc(d, key, n=1):
    d[key] = d.get(key, 0) + n


class Tally:
    """Aggregate counters fed with key presses and releases.

    Sequences (pairs, skip-pairs, triples) follow typing only: modifiers are
    left out of them, and a key pressed with Ctrl, Alt or Super held counts as
    a shortcut instead. Shift is part of normal typing, so Shift+letter stays in
    the sequence and is only tallied as `shifted`.
    """

    COUNTERS = ("keys", "bigrams", "skipgrams", "trigrams", "chords",
                "holds", "overlaps")
    TOTALS = ("rolls", "seq_presses", "shifted")

    def __init__(self, data=None):
        data = data or {}
        for name in self.COUNTERS:
            setattr(self, name, dict(data.get(name, {})))
        for name in self.TOTALS:
            setattr(self, name, int(data.get(name, 0)))
        # per-key hold time: label -> [total ms, samples]
        self.key_holds = {k: list(v) for k, v in data.get("key_holds", {}).items()}
        self.down = {}        # label -> press time, for keys currently held
        self.roll_from = {}   # held key -> time the next key went down over it
        self.history = []     # last two sequence presses: [(label, time)]

    def press(self, label, t):
        _inc(self.keys, label)
        mods = sorted(m for m in self.down if m in MODIFIERS and m != label)
        if label in MODIFIERS:
            self.down[label] = t
            return
        shortcut = [m for m in mods if m not in SHIFTS]
        if shortcut:
            # A shortcut, not typing: count the combination, break the sequence.
            _inc(self.chords, "+".join(mods + [label]))
            self.history = []
        else:
            if mods:
                self.shifted += 1
            self._sequence(label, t)
            self.seq_presses += 1
            for other in self.down:
                if other not in MODIFIERS and other != label and other not in self.roll_from:
                    self.roll_from[other] = t
                    self.rolls += 1
                    break
        self.down[label] = t

    def _sequence(self, label, t):
        hist = self.history
        if hist and t - hist[-1][1] >= SEQUENCE_GAP:
            hist = []
        if hist:
            _inc(self.bigrams, hist[-1][0] + ">" + label)
            if len(hist) == 2:
                _inc(self.skipgrams, hist[0][0] + ">" + label)
                _inc(self.trigrams, hist[0][0] + ">" + hist[1][0] + ">" + label)
        hist.append((label, t))
        self.history = hist[-2:]

    def release(self, label, t):
        start = self.down.pop(label, None)
        if start is None or label in MODIFIERS:
            self.roll_from.pop(label, None)
            return
        ms = (t - start) * 1000.0
        _inc(self.holds, _bucket(ms))
        acc = self.key_holds.setdefault(label, [0, 0])
        acc[0] += int(round(ms))
        acc[1] += 1
        over = self.roll_from.pop(label, None)
        if over is not None:
            _inc(self.overlaps, _bucket((t - over) * 1000.0))

    def drop_held(self):
        """Forget keys held on a keyboard that went away."""
        self.down.clear()
        self.roll_from.clear()
        self.history = []

    def to_dict(self):
        out = {"version": 2, "updated": int(time.time())}
        for name in self.COUNTERS:
            out[name] = getattr(self, name)
        for name in self.TOTALS:
            out[name] = getattr(self, name)
        out["key_holds"] = self.key_holds
        return out


def load_stats(path=None):
    return _read_json(path or STATS, {})


# ---------------------------------------------------------------------------
# layout - which finger types which key
# ---------------------------------------------------------------------------
class Layout:
    def __init__(self, keys, grid, name, source):
        self.keys = keys      # label -> (hand, finger, row)
        self.grid = grid      # rows of (label, width); "" is a gap
        self.name = name
        self.source = source  # "default" | path of layout.json

    def finger(self, label):
        return self.keys.get(label, ("?", "other", None))

    def home(self):
        return {k for k, v in self.keys.items() if v[2] == 1}


def default_layout():
    return Layout(dict(QWERTY), QWERTY_GRID, "QWERTY (row-staggered)", "default")


def load_layout(path=None):
    path = path or LAYOUT_FILE
    data = _read_json(path, None)
    if not isinstance(data, dict) or not isinstance(data.get("keys"), dict):
        return default_layout()
    keys = {}
    for label, spec in data["keys"].items():
        if isinstance(spec, list) and len(spec) == 3:
            keys[str(label)] = (str(spec[0]), str(spec[1]), spec[2])
    if not keys:
        return default_layout()
    grid = []
    for row in data.get("grid") or []:
        grid.append([(str(c[0]) if c and c[0] else "", float(c[1]) if c else 1)
                     for c in row])
    return Layout(keys, grid or QWERTY_GRID, str(data.get("name") or "custom"), path)


