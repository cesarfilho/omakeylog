# Keys typed further apart than this (seconds) do not form a pair, skip-pair or
# triple; that keeps idle pauses from inventing meaningless transitions.
SEQUENCE_GAP = 1.5
FLUSH_SECONDS = 5.0
# How often the recorder looks for keyboards plugged in after it started.
RESCAN_SECONDS = 3.0
# How often it checks that its login session is still the active, unlocked one.
SESSION_CHECK_SECONDS = 1.0
# Check sooner when this many keys are waiting for the check to count them.
PENDING_MAX = 512
# Hold and overlap histograms: 10 ms buckets, everything >= 1 s in one bucket.
BUCKET_MS = 10
BUCKET_CAP_MS = 1000

MODIFIERS = {
    "LEFTCTRL", "RIGHTCTRL", "LEFTSHIFT", "RIGHTSHIFT",
    "LEFTALT", "RIGHTALT", "LEFTMETA", "RIGHTMETA",
}
SHIFTS = {"LEFTSHIFT", "RIGHTSHIFT"}

