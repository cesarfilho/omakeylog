def do_stop(_args):
    _set_wanted(False)
    pid = read_pid()
    if not pid_alive(pid):
        try:
            os.remove(PIDFILE)
        except OSError:
            pass
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    return 0


def do_status(_args):
    pid = read_pid()
    recording = pid_alive(pid)
    saved = _read_json(STATUS, {})
    keys = load_stats().get("keys", {})
    status = {
        "recording": recording,
        "paused": bool(saved.get("paused")) if recording else False,
        "pid": pid if recording else 0,
        "devices": saved.get("devices", []) if recording else [],
        "error": saved.get("error") if not recording else None,
        "total": sum(keys.values()),
        "distinct": len(keys),
        "wanted": _wanted(),
    }
    _write_json(STATUS, status)
    print(json.dumps(status))
    return 0


