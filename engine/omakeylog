    "RGUI": "RIGHTMETA", "RCMD": "RIGHTMETA", "RWIN": "RIGHTMETA", "RIGHT_GUI": "RIGHTMETA",
}
MOD_HOLD = {
    "LCTL": "LEFTCTRL", "RCTL": "RIGHTCTRL", "LSFT": "LEFTSHIFT", "RSFT": "RIGHTSHIFT",
    "LALT": "LEFTALT", "LOPT": "LEFTALT", "RALT": "RIGHTALT", "ROPT": "RIGHTALT",
    "LGUI": "LEFTMETA", "LCMD": "LEFTMETA", "RGUI": "RIGHTMETA", "RCMD": "RIGHTMETA",
}


def qmk_label(code):
    """Labels a QMK/Vial keycode produces: (tap label, hold-modifier label).

    LSFT_T(KC_A) -> ("A", "LEFTSHIFT"); LT(1, KC_SPC) -> ("SPACE", None);
    MO(1) -> (None, None).
    """
    if not isinstance(code, str):
        return None, None
    hold = None
    m = re.match(r"^(L|R)(CTL|SFT|ALT|OPT|GUI|CMD)_T\(", code)
    if m:
        hold = MOD_HOLD.get(m.group(1) + m.group(2))
    m = re.search(r"MOD_(L|R)(CTL|SFT|ALT|OPT|GUI|CMD)", code)
    if m and code.startswith("MT("):
        hold = MOD_HOLD.get(m.group(1) + m.group(2))
    kcs = re.findall(r"KC_([A-Z0-9_]+)", code)
    if not kcs:
        return None, hold
    name = kcs[-1]
    if re.fullmatch(r"[A-Z]|[0-9]|F[0-9]{1,2}", name):
        return name, hold
    return QMK_NAMES.get(name), hold


def _finger_for_column(c_outer, ncols):
    """Finger for a column counted from the outer edge of one half."""
    if ncols <= 4:
        names = ["pinky", "ring", "middle", "index"][4 - ncols:]
        return names[c_outer]
    # pinky takes any extra outer columns, index the two inner ones
    inner = ncols - 1 - c_outer
    if inner <= 1:
        return "index"
    if inner == 2:
        return "middle"
    if inner == 3:
        return "ring"
    return "pinky"


def layout_from_vil(vil, right_inner_first=False):
    """Build a layout dict from a Vial .vil export.

    Assumes a split board whose matrix lists the left half's rows first and the
    right half's after (the usual Vial/QMK split layout). The last row of each
    half is the thumb row; the rows above count up from the bottom row.
    """
    layers = vil.get("layout") if isinstance(vil, dict) else None
    if not layers or not isinstance(layers, list):
        raise ValueError("no 'layout' in the Vial file")
    base = layers[0]
    nrows = len(base)
    if nrows < 2:
        raise ValueError("the Vial layout has fewer than two rows")
    split = nrows % 2 == 0 and nrows >= 4
    half_rows = nrows // 2 if split else nrows

    def position(r, c, row):
        ncols = len(row)
        if split:
            hand = "L" if r < half_rows else "R"
            rr = r if hand == "L" else r - half_rows
            c_outer = c if (hand == "L" or not right_inner_first) else ncols - 1 - c
        else:
            rr = r
            hand = "L" if c < ncols / 2 else "R"
            half = ncols // 2
            c_outer = c if hand == "L" else ncols - 1 - c
            ncols = half if hand == "L" else ncols - half
        if rr == half_rows - 1 and half_rows >= 2:
            return hand, "thumb", -1
        row_code = (half_rows - 2) - rr  # 0 bottom, 1 home, 2 top, 3 number...
        row_code = min(row_code, 3)
        return hand, _finger_for_column(min(c_outer, ncols - 1), ncols), row_code

    keys = {}
    holds = {}
    for layer in layers:
        for r, row in enumerate(layer):
            for c, code in enumerate(row):
                tap, hold = qmk_label(code)
                pos = position(r, c, row)
                if tap and tap not in keys:
                    keys[tap] = pos
                if hold and hold not in holds:
                    holds[hold] = pos
    for label, pos in holds.items():
        keys.setdefault(label, pos)

    grid = []
    for r in range(half_rows):
        if split:
            left = base[r]
            right = base[r + half_rows]
            right = list(right) if right_inner_first else list(reversed(right))
            cells = [qmk_label(c)[0] or "" for c in left] + [""]
            cells += [qmk_label(c)[0] or "" for c in right]
        else:
            cells = [qmk_label(c)[0] or "" for c in base[r]]
        grid.append([[c, 1] for c in cells])

    return {
        "name": "Vial keymap",
        "keys": {k: list(v) for k, v in keys.items()},
        "grid": grid,
    }


# ---------------------------------------------------------------------------
# record
# ---------------------------------------------------------------------------
def _is_keyboard(dev):
    import evdev

    keys = dev.capabilities().get(evdev.ecodes.EV_KEY, [])
    # A real typing keyboard has letters and a space bar; this skips mice,
    # power buttons, lid switches and other EV_KEY-only devices.
    return (evdev.ecodes.KEY_A in keys and evdev.ecodes.KEY_Z in keys
            and evdev.ecodes.KEY_SPACE in keys)


UDEV_DATA = "/run/udev/data"


def device_seat(path):
    """The logind seat a /dev/input node belongs to, or None if unknown.

    udev tags devices with ID_SEAT; an untagged device belongs to seat0.
    """
    try:
        rdev = os.stat(path).st_rdev
    except OSError:
        return None
    data = os.path.join(UDEV_DATA, "c%d:%d" % (os.major(rdev), os.minor(rdev)))
    try:
        with open(data) as fh:
            lines = fh.read().splitlines()
    except OSError:
        try:
            r = subprocess.run(["udevadm", "info", "--query=property", "--name=" + path],
                               capture_output=True, text=True, timeout=3)
        except (OSError, subprocess.SubprocessError):
            return None
        if r.returncode != 0:
            return None
        lines = ["E:" + line for line in r.stdout.splitlines()]
    for line in lines:
        if line.startswith("E:ID_SEAT="):
            return line.split("=", 1)[1] or "seat0"
    return "seat0"


def open_keyboards(paths, explicit, skip=(), seat=None):
    """Open the keyboards among paths that sit on `seat`.

    Returns (devices, denied, rejected). On a multiseat machine another seat's
    keyboard belongs to someone else, so it is rejected even when readable.
    """
    import evdev

    devices, denied, rejected = [], False, []
    for path in paths:
        if path in skip:
            continue
        if device_seat(path) != seat:
            rejected.append(path)
            continue
        try:
            dev = evdev.InputDevice(path)
        except PermissionError:
            denied = True
            continue
        except OSError:
            continue
        if explicit or _is_keyboard(dev):
            devices.append(dev)
        else:
            rejected.append(path)
            dev.close()
    return devices, denied, rejected


def label_for(code):
    import evdev

    name = evdev.ecodes.KEY.get(code)
    if isinstance(name, (list, tuple)):
        name = name[0]
    if not name:
        return None
    return name[4:] if name.startswith("KEY_") else name


def _write_status(recording, devices, error, total, paused=False):
    _write_json(STATUS, {
        "recording": recording,
        "paused": paused,
        "pid": os.getpid() if recording else 0,
        "devices": devices,
        "error": error,
        "total": total,
        "wanted": _wanted(),
    })


# ---------------------------------------------------------------------------
# session - count only the owner's own typing
# ---------------------------------------------------------------------------
def _loginctl(*args):
    try:
        r = subprocess.run(["loginctl"] + list(args), capture_output=True,
                           text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def session_seat(sid):
    """The seat of session sid ("seat0"), or None for a seat-less session."""
    if not sid:
        return None
    return _loginctl("show-session", sid, "-p", "Seat", "--value") or None


def _run_quiet(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def screen_locked():
    """True when a screen locker is up. Not every locker reports LockedHint to
    logind (Omarchy's own lock screen does not), so ask the lockers directly.
    Only an explicit "false" from Omarchy counts as unlocked: a failed, timed
    out or unexpected answer counts as locked."""
    if _run_quiet(["pgrep", "-u", str(os.getuid()), "-x", "hyprlock"]):
        return True
    return _run_quiet(["omarchy-shell", "lock", "isLocked"]) != "false"


def session_id():
    """The logind session this recorder belongs to."""
    sid = os.environ.get("XDG_SESSION_ID")
    if sid:
        return sid
    return _loginctl("show-user", str(os.getuid()), "-p", "Display", "--value") or None


def session_active(sid):
    """True only while sid is the foreground session on its seat and unlocked.

    The keyboards are shared by every session on the seat, so when another user
    switches to their session (or the screen is locked) keys must not be
    counted. Anything that cannot be confirmed counts as inactive.
    """
    if not sid:
        return False
    out = _loginctl("show-session", sid, "-p", "Active", "-p", "LockedHint")
    if out is None:
        return False
    props = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    if props.get("Active") != "yes" or props.get("LockedHint") == "yes":
        return False
    return not screen_locked()


class PendingKeys:
    """Keys read but not yet counted.

    The session is checked once a second, so a key read now may belong to a
    user switch or a lock that the last check has not seen yet. Keys wait here
    and are counted only when the check that follows them confirms the session
    was active and unlocked both before and after; otherwise they are thrown
    away. Losing the last second of typing before a lock is the price.
    """

    def __init__(self, tally):
        self.tally = tally
        self.items = []

    def add(self, label, pressed, at):
        self.items.append((label, pressed, at))

    def device_gone(self):
        if self.items:
            self.items.append(None)

    def full(self):
        return len(self.items) >= PENDING_MAX

    def settle(self, active_before, active_now):
        """Count or discard what is waiting; True when anything changed."""
        items, self.items = self.items, []
        if not (active_before and active_now):
            if active_before != active_now:
                self.tally.drop_held()
                return True
            return False
        for item in items:
            if item is None:  # a keyboard went away here
                self.tally.drop_held()
            elif item[1]:
                self.tally.press(item[0], item[2])
            else:
                self.tally.release(item[0], item[2])
        return bool(items)


def do_record(args):
    explicit = []
    foreground = False
    it = iter(args)
    for a in it:
        if a == "--device":
            explicit.append(next(it, ""))
        elif a == "--foreground":
            foreground = True
    explicit = [p for p in explicit if p]

    try:
        import evdev  # noqa: F401
    except ImportError:
        _write_status(False, [], "python-evdev is not installed", 0)
        sys.stderr.write("omakeylog: python-evdev is not installed\n")
        return 1

    if pid_alive(read_pid()):
        sys.stderr.write("omakeylog: already recording\n")
        return 0

    def fail(msg):
        _write_status(False, [], msg, sum(load_stats().get("keys", {}).values()))
        sys.stderr.write("omakeylog: " + msg + "\n")
        return 1

    # Typing is attributed through logind: the recorder's own session, and only
    # the keyboards on that session's seat.
    sid = session_id()
    seat = session_seat(sid)
    if not sid or not seat:
        return fail("no graphical login session with a seat (logind), "
                    "so typing cannot be attributed to you")

    # Glob directly rather than evdev.list_devices(), which silently omits
    # devices the process cannot open - we want to see the PermissionError so a
    # missing 'input' group is reported as such instead of "no keyboard".
    paths = explicit or sorted(glob.glob("/dev/input/event*"))
    devices, denied, rejected = open_keyboards(paths, bool(explicit), seat=seat)
    if not devices:
        return fail(
            "no read access to /dev/input (add yourself to the 'input' group)"
            if denied
            else "no keyboard devices found on " + seat
        )

    _set_wanted(True)
    if not foreground:
        _daemonize()

    _run_loop(devices, hotplug=not explicit, rejected=rejected, session=sid, seat=seat)
    return 0


def do_resume(args):
    """Start recording again if it was on before (reboot, logout)."""
    if _wanted() and not pid_alive(read_pid()):
        return do_record(args)
    return 0


def _daemonize():
    if os.fork() > 0:
        os._exit(0)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    sys.stdout.flush()
    sys.stderr.flush()
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)


def _run_loop(devices, hotplug=True, rejected=(), session=None, seat="seat0"):
    import selectors
    import evdev

    _write_private(PIDFILE, str(os.getpid()))

    tally = Tally(load_stats())
    running = {"on": True}

    def stop(_signo, _frame):
        running["on"] = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    sel = selectors.DefaultSelector()
    open_paths = {}
    for dev in devices:
        sel.register(dev, selectors.EVENT_READ)
        open_paths[dev.path] = dev
    rejected = set(rejected)

    def names():
        return [d.name for d in open_paths.values()]

    def drop(dev):
        # An unplugged keyboard stays readable forever with an error; leaving it
        # registered would spin this loop at 100% CPU.
        try:
            sel.unregister(dev)
        except (KeyError, ValueError):
            pass
        try:
            dev.close()
        except OSError:
            pass
        open_paths.pop(dev.path, None)
        tally.drop_held()

    def rescan():
        present = set(glob.glob("/dev/input/event*"))
        rejected.intersection_update(present)  # a reused path gets a fresh look
        new = sorted(present - set(open_paths) - rejected)
        if not new:
            return False
        found, _denied, rej = open_keyboards(new, False, seat=seat)
        rejected.update(rej)
        for dev in found:
            sel.register(dev, selectors.EVENT_READ)
            open_paths[dev.path] = dev
        return bool(found)

    dirty = False
    last_flush = last_scan = last_session = time.monotonic()
    active = {"on": session_active(session)}
    pending = PendingKeys(tally)

    def flush():
        _write_json(STATS, tally.to_dict())
        _write_status(True, names(), None, sum(tally.keys.values()),
                      paused=not active["on"])

    flush()
    while running["on"]:
        for selkey, _ in sel.select(timeout=1.0):
            dev = selkey.fileobj
            try:
                events = list(dev.read())
            except OSError:
                drop(dev)
                pending.device_gone()
                dirty = True
                continue
            if not active["on"]:
                continue  # drained and discarded: not this user's typing
            for ev in events:
                # 1 press, 0 release; 2 (auto-repeat) is not a new keypress
                if ev.type != evdev.ecodes.EV_KEY or ev.value == 2:
                    continue
                label = label_for(ev.code)
                if not label or label.startswith("BTN_"):
                    continue
                pending.add(label, ev.value == 1, ev.timestamp())
        now = time.monotonic()
        if now - last_session >= SESSION_CHECK_SECONDS or pending.full():
            last_session = now
            was, active["on"] = active["on"], session_active(session)
            if pending.settle(was, active["on"]):
                dirty = True
            if was != active["on"]:
                dirty = True
                last_flush = 0  # show the pause in the panel right away
        if hotplug and now - last_scan >= RESCAN_SECONDS:
            last_scan = now
            if rescan():
                dirty = True
        if dirty and now - last_flush >= FLUSH_SECONDS:
            flush()
            dirty = False
            last_flush = now

    pending.settle(active["on"], active["on"] and session_active(session))
    _write_json(STATS, tally.to_dict())
    _write_status(False, names(), None, sum(tally.keys.values()))
    try:
        os.remove(PIDFILE)
    except OSError:
        pass


