def _percentile(hist, q):
    total = sum(hist.values())
    if not total:
        return None
    need = q * total
    acc = 0
    for bucket in sorted(hist, key=int):
        acc += hist[bucket]
        if acc >= need:
            return int(bucket) + BUCKET_MS // 2
    return BUCKET_CAP_MS


def _split(pair):
    return pair.split(">")


def _trigram_kind(fingers):
    """Classify three (hand, finger) positions the way layout analyzers do."""
    hands = [f[0] for f in fingers]
    if any(h not in ("L", "R") for h in hands):
        return None
    if (fingers[0] == fingers[1] or fingers[1] == fingers[2]):
        return "sfb"
    if hands[0] != hands[1] and hands[1] != hands[2]:
        return "alternate"
    if hands[0] == hands[1] == hands[2]:
        r = [FINGER_RANK.get(f[1], 0) for f in fingers]
        if fingers[0] == fingers[2]:
            return "redirect"
        if (r[0] < r[1] < r[2]) or (r[0] > r[1] > r[2]):
            return "onehand"
        return "redirect"
    return "roll"


def summarize(stats, layout):
    """The parts of a report that two recordings can be compared on."""
    keys = stats.get("keys", {})
    bigrams = stats.get("bigrams", {})
    total = sum(keys.values())

    def pct(n, of=None):
        of = total if of is None else of
        return round(100.0 * n / of, 2) if of else 0.0

    hands = {"L": 0, "R": 0, "thumb": 0, "?": 0}
    fingers = {fp: 0 for fp in FINGER_ORDER}
    rows = {name: 0 for name in ROW_NAME.values()}
    rows["other"] = 0
    for label, count in keys.items():
        hand, finger, row = layout.finger(label)
        if finger == "thumb":
            hands["thumb"] += count
        else:
            hands[hand if hand in ("L", "R") else "?"] += count
        if (hand, finger) in fingers:
            fingers[(hand, finger)] += count
        rows[ROW_NAME.get(row, "other")] += count

    used = {(v[0], v[1]) for v in layout.keys.values()}
    finger_load = [
        {"finger": h + "-" + f, "pct": pct(fingers[(h, f)]), "count": fingers[(h, f)]}
        for (h, f) in FINGER_ORDER if (h, f) in used
    ]

    bi_total = sum(bigrams.values())
    sfb_count, sfb_items = 0, []
    for pair, count in sorted(bigrams.items(), key=lambda kv: kv[1], reverse=True):
        a, b = _split(pair)
        if a == b:
            continue
        fa, fb = layout.finger(a), layout.finger(b)
        if fa[:2] == fb[:2] and fa[0] in ("L", "R"):
            sfb_count += count
            sfb_items.append({"pair": a + " " + b, "count": count})

    return {
        "total": total,
        "keys": keys,
        "fingers": fingers,
        "finger_load": finger_load,
        "hands": hands,
        "rows": rows,
        "bi_total": bi_total,
        "sfb_count": sfb_count,
        "sfb_items": sfb_items,
        "sfb_pct": pct(sfb_count, bi_total),
        "pct": pct,
        "hands_pct": {
            "left": pct(hands["L"]), "right": pct(hands["R"]),
            "thumb": pct(hands["thumb"]), "other": pct(hands["?"]),
        },
    }


def latest_backup():
    found = glob.glob(STATS + ".*.bak")
    return max(found, key=os.path.getmtime) if found else None


def build_report(stats=None, layout=None, baseline=None, baseline_name=None):
    stats = load_stats() if stats is None else stats
    layout = layout or load_layout()
    s = summarize(stats, layout)
    total, pct = s["total"], s["pct"]
    keys = s["keys"]
    ranked = sorted(keys.items(), key=lambda kv: kv[1], reverse=True)

    top_keys = [{"label": k, "count": c, "pct": pct(c)} for k, c in ranked]

    bigrams = stats.get("bigrams", {})
    top_bigrams = [
        {"pair": " ".join(_split(p)), "count": c}
        for p, c in sorted(bigrams.items(), key=lambda kv: kv[1], reverse=True)
    ][:50]

    # same-finger skipgrams: one finger with a key in between
    skipgrams = stats.get("skipgrams", {})
    sk_total = sum(skipgrams.values())
    sfs_count, sfs_items = 0, []
    for pair, count in sorted(skipgrams.items(), key=lambda kv: kv[1], reverse=True):
        a, b = _split(pair)
        if a == b:
            continue
        fa, fb = layout.finger(a), layout.finger(b)
        if fa[:2] == fb[:2] and fa[0] in ("L", "R"):
            sfs_count += count
            sfs_items.append({"pair": a + " " + b, "count": count})

    # trigram patterns
    trigrams = stats.get("trigrams", {})
    kinds = {"alternate": 0, "roll": 0, "onehand": 0, "redirect": 0, "sfb": 0}
    tri_counted = 0
    for tri, count in trigrams.items():
        parts = _split(tri)
        if len(parts) != 3:
            continue
        kind = _trigram_kind([layout.finger(p)[:2] for p in parts])
        if kind:
            kinds[kind] += count
            tri_counted += count
    tri_top = [
        {"keys": " ".join(_split(t)), "count": c}
        for t, c in sorted(trigrams.items(), key=lambda kv: kv[1], reverse=True)[:15]
    ]

    chords = stats.get("chords", {})
    top_chords = [
        {"chord": k, "count": c}
        for k, c in sorted(chords.items(), key=lambda kv: kv[1], reverse=True)[:15]
    ]

    timing = _timing(stats, layout)

    heat_max = max(keys.values()) if keys else 0
    heatmap = [
        [{"label": lbl, "w": w, "count": keys.get(lbl, 0) if lbl else 0,
          "pct": pct(keys.get(lbl, 0)) if lbl else 0,
          "heat": round(keys.get(lbl, 0) / heat_max, 3) if lbl and heat_max else 0}
         for lbl, w in row]
        for row in layout.grid
    ]

    compare = None
    if baseline is not None:
        b = summarize(baseline, layout)
        if b["total"] > 0:
            bf = {fl["finger"]: fl["pct"] for fl in b["finger_load"]}
            compare = {
                "against": baseline_name or "previous recording",
                "total": b["total"],
                "sfb_pct": b["sfb_pct"],
                "sfb_delta": round(s["sfb_pct"] - b["sfb_pct"], 2),
                "hands": b["hands_pct"],
                "fingers": {k: v for k, v in bf.items()},
            }

    report = {
        "total": total,
        "distinct": len(keys),
        "layout": {"name": layout.name, "source": layout.source},
        "top_keys": top_keys,
        "hands": s["hands_pct"],
        "fingers": [
            dict(fl, delta=(round(fl["pct"] - compare["fingers"].get(fl["finger"], 0), 2)
                            if compare else None))
            for fl in s["finger_load"]
        ],
        "rows": {k: pct(v) for k, v in s["rows"].items()},
        "top_bigrams": top_bigrams,
        "sfb": {"pct": s["sfb_pct"], "top": s["sfb_items"][:10]},
        "sfs": {"pct": pct(sfs_count, sk_total), "top": sfs_items[:10]},
        "trigrams": {
            "total": tri_counted,
            "kinds": {k: pct(v, tri_counted) for k, v in kinds.items()},
            "top": tri_top,
        },
        "chords": {
            "total": sum(chords.values()),
            "top": top_chords,
            "shifted_pct": pct(int(stats.get("shifted", 0)), int(stats.get("seq_presses", 0))),
        },
        "timing": timing,
        "heatmap": heatmap,
        "compare": compare,
    }
    report["suggestions"] = _suggestions(report, ranked, s, layout)
    return report


def _timing(stats, layout):
    holds = stats.get("holds", {})
    samples = sum(holds.values())
    overlaps = stats.get("overlaps", {})
    seq = int(stats.get("seq_presses", 0))
    rolls = int(stats.get("rolls", 0))
    home = layout.home()
    key_holds = stats.get("key_holds", {})
    home_holds = sorted(
        ({"label": k, "ms": int(round(v[0] / v[1])), "samples": v[1]}
         for k, v in key_holds.items() if k in home and v[1] > 0),
        key=lambda d: d["ms"], reverse=True,
    )
    p95 = _percentile(holds, 0.95)
    tapping = None
    if samples >= 300 and p95 is not None:
        # a home-row mod must not fire on an ordinary tap, so the tapping term
        # sits above nearly all of your taps, with a margin
        tapping = int(min(300, max(150, math.ceil((p95 + 30) / 10.0) * 10)))
    hist = [
        {"ms": int(b), "count": c}
        for b, c in sorted(holds.items(), key=lambda kv: int(kv[0]))
    ]
    return {
        "samples": samples,
        "hold_median": _percentile(holds, 0.5),
        "hold_p95": p95,
        "home_holds": home_holds,
        "roll_pct": round(100.0 * rolls / seq, 2) if seq else 0.0,
        "overlap_median": _percentile(overlaps, 0.5),
        "overlap_p90": _percentile(overlaps, 0.9),
        "tapping_term": tapping,
        "hold_hist": hist,
    }


def _suggestions(rep, ranked, s, layout):
    out = []
    total = rep["total"]
    if total == 0:
        return ["No data yet. Start recording and type for a while."]
    pct = s["pct"]
    home = layout.home()

    off_home = [
        (k, c) for k, c in ranked
        if k not in home and layout.finger(k)[2] in (0, 2, 3) and k not in MODIFIERS
    ][:5]
    if off_home:
        names = ", ".join("%s (%s%%)" % (k, pct(c)) for k, c in off_home)
        out.append(
            "Frequent keys off the home row - consider a layer, a thumb key or "
            "relocating them: " + names
        )

    big = [(k, c) for k, c in ranked[:8] if layout.finger(k)[0] in ("L", "R")]
    if big:
        names = ", ".join("%s (%s%%)" % (k, pct(c)) for k, c in big)
        out.append("Most-pressed keys overall (prime real estate): " + names)

    fingers = s["fingers"]
    for (h, f) in FINGER_ORDER:
        if f in ("index", "thumb"):
            continue
        p = pct(fingers[(h, f)])
        if p >= 18.0:
            out.append("%s-%s is carrying %s%% of presses - spread that load." % (h, f, p))

    used = {(v[0], v[1]) for v in layout.keys.values()}
    idle = [
        h + "-" + f for (h, f) in FINGER_ORDER
        if (h, f) in used and f not in ("thumb", "index") and pct(fingers[(h, f)]) < 2.0
    ]
    if idle:
        out.append("Underused fingers you could give more to: " + ", ".join(idle))

    if rep["sfb"]["pct"] >= 3.0:
        out.append(
            "Same-finger bigrams are %s%% of pairs - a layout that separates "
            "those keys onto different fingers would type smoother." % rep["sfb"]["pct"]
        )
    if rep["sfs"]["pct"] >= 8.0:
        out.append(
            "Same-finger skipgrams (one finger, one key in between) are %s%% - "
            "worth checking when you compare alternative layouts." % rep["sfs"]["pct"]
        )

    chords = rep["chords"]["top"]
    if chords and chords[0]["count"] >= max(20, total * 0.005):
        names = ", ".join(c["chord"].replace("LEFT", "L").replace("RIGHT", "R")
                          for c in chords[:4])
        out.append(
            "Your most-used shortcuts: %s - a combo or a shortcut layer can save "
            "the modifier reach." % names
        )

    t = rep["timing"]
    if t["tapping_term"]:
        out.append(
            "For home-row mods, TAPPING_TERM %d ms sits above 95%% of your taps "
            "(median tap %s ms)." % (t["tapping_term"], t["hold_median"])
        )
    if t["roll_pct"] >= 15.0:
        out.append(
            "%s%% of your keypresses roll over the previous key - with home-row "
            "mods, enable Chordal Hold or a longer tapping term to avoid "
            "accidental modifiers." % t["roll_pct"]
        )

    cmp_ = rep["compare"]
    if cmp_:
        delta = cmp_["sfb_delta"]
        trend = "down" if delta < 0 else ("up" if delta > 0 else "unchanged")
        out.append(
            "Since the previous recording, same-finger bigrams went %s: %s%% -> %s%%."
            % (trend, cmp_["sfb_pct"], rep["sfb"]["pct"])
        )
    return out


def do_report(args):
    baseline = name = None
    if "--no-compare" not in args:
        path = latest_backup()
        if path:
            baseline = load_stats(path)
            name = os.path.basename(path)
    rep = build_report(baseline=baseline, baseline_name=name)
    if "--json" in args:
        _write_json(REPORT, rep)
        print(json.dumps(rep))
        return 0
    if "--csv" in args:
        print("key,count,percent")
        for row in rep["top_keys"]:
            print("%s,%d,%s" % (row["label"], row["count"], row["pct"]))
        return 0
    _print_human(rep)
    # keep report.json fresh for the UI even on a plain report
    _write_json(REPORT, rep)
    return 0


def _bar(pct, width=24):
    filled = int(round(pct / 100.0 * width))
    return "#" * filled + "." * (width - filled)


def _print_human(rep):
    if rep["total"] == 0:
        print("No keypresses recorded yet. Run 'omakeylog record' and type.")
        return
    print("omakeylog report  -  %d keypresses, %d distinct keys  (layout: %s)\n"
          % (rep["total"], rep["distinct"], rep["layout"]["name"]))

    print("Top keys:")
    for row in rep["top_keys"][:20]:
        print("  %-12s %7d  %5s%%  %s"
              % (row["label"], row["count"], row["pct"], _bar(row["pct"])))

    h = rep["hands"]
    print("\nHand balance:  left %s%%   right %s%%   thumb %s%%"
          % (h["left"], h["right"], h["thumb"]))

    print("\nFinger load:")
    for row in rep["fingers"]:
        delta = ""
        if row.get("delta") is not None:
            delta = "  (%+.2f)" % row["delta"]
        print("  %-10s %5s%%  %s%s" % (row["finger"], row["pct"], _bar(row["pct"]), delta))

    r = rep["rows"]
    print("\nRow usage:  home %s%%   top %s%%   bottom %s%%   number %s%%   thumb %s%%"
          % (r.get("home", 0), r.get("top", 0), r.get("bottom", 0),
             r.get("number", 0), r.get("thumb", 0)))

    print("\nTop key-pairs:")
    for row in rep["top_bigrams"][:15]:
        print("  %-10s %7d" % (row["pair"], row["count"]))

    if rep["sfb"]["top"]:
        print("\nSame-finger bigrams (%s%% of pairs) - minimize these:"
              % rep["sfb"]["pct"])
        for row in rep["sfb"]["top"]:
            print("  %-10s %7d" % (row["pair"], row["count"]))

    tri = rep["trigrams"]
    if tri["total"]:
        k = tri["kinds"]
        print("\nTrigrams:  alternate %s%%   roll %s%%   one-hand %s%%   redirect %s%%   sfb %s%%"
              % (k["alternate"], k["roll"], k["onehand"], k["redirect"], k["sfb"]))

    if rep["chords"]["top"]:
        print("\nTop shortcuts:")
        for row in rep["chords"]["top"][:10]:
            print("  %-22s %7d" % (row["chord"], row["count"]))

    t = rep["timing"]
    if t["samples"]:
        print("\nTiming:  median tap %s ms   95%% of taps under %s ms   rolls %s%%"
              % (t["hold_median"], t["hold_p95"], t["roll_pct"]))
        if t["tapping_term"]:
            print("  suggested TAPPING_TERM: %d ms" % t["tapping_term"])

    print("\nQMK suggestions:")
    for s in rep["suggestions"]:
        print("  - " + s)


# ---------------------------------------------------------------------------
# reset / layout
# ---------------------------------------------------------------------------
def do_reset(_args):
    if os.path.exists(STATS):
        backup = STATS + "." + time.strftime("%Y%m%d-%H%M%S") + ".bak"
        os.replace(STATS, backup)
        print("backed up previous stats to " + backup)
    for path in (REPORT,):
        try:
            os.remove(path)
        except OSError:
            pass
    print("counts reset")
    return 0


def do_layout(args):
    sub = args[0] if args else "show"
    if sub == "show":
        layout = load_layout()
        print("layout: %s  (%s)" % (layout.name, layout.source))
        by_finger = {}
        for label, (hand, finger, row) in sorted(layout.keys.items()):
            by_finger.setdefault(hand + "-" + finger, []).append(label)
        for (h, f) in FINGER_ORDER:
            labels = by_finger.get(h + "-" + f)
            if labels:
                print("  %-9s %s" % (h + "-" + f, " ".join(labels)))
        return 0
    if sub == "import-vil":
        if len(args) < 2:
            sys.stderr.write("usage: omakeylog layout import-vil FILE [--right-inner-first]\n")
            return 2
        vil = _read_json(args[1], None)
        if vil is None:
            sys.stderr.write("omakeylog: cannot read %s as JSON\n" % args[1])
            return 1
        try:
            data = layout_from_vil(vil, right_inner_first="--right-inner-first" in args)
        except ValueError as exc:
            sys.stderr.write("omakeylog: %s\n" % exc)
            return 1
        _write_json(LAYOUT_FILE, data)
        print("wrote %s (%d keys). Check it with: omakeylog layout show"
              % (LAYOUT_FILE, len(data["keys"])))
        return 0
    if sub == "reset":
        try:
            os.remove(LAYOUT_FILE)
            print("removed %s; using QWERTY" % LAYOUT_FILE)
        except OSError:
            print("already using QWERTY")
        return 0
    sys.stderr.write("usage: omakeylog layout show | import-vil FILE | reset\n")
    return 2


COMMANDS = {
    "record": do_record,
    "resume": do_resume,
    "stop": do_stop,
    "status": do_status,
    "report": do_report,
    "reset": do_reset,
    "layout": do_layout,
}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        sys.stderr.write(__doc__)
        return 2
    os.umask(0o077)
    secure_existing()
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
